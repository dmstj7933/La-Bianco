# ==========================================
# 1. 에이전트 설정 파일
# ==========================================
.agent/*

# ==========================================
# 2. Windows 시스템 & 탐색기 찌꺼기 파일
# ==========================================
# 폴더 보기 설정 파일 (윈도우에서 폴더 열 때 매우 흔하게 생성됨)
desktop.ini
Desktop.ini

# 썸네일 캐시 파일
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# 윈도우 휴지통 및 다운로드 식별자 메타데이터
$RECYCLE.BIN/
*Zone.Identifier
*:Zone.Identifier

# 윈도우 바로가기 파일 (비개발자가 파일 복사 대신 링크를 넣는 실수 방지)
*.lnk

# ==========================================
# 3. macOS 시스템 파일 & 압축 해제 찌꺼기
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
# Mac에서 압축한 zip을 Windows에서 풀 때 생기는 숨김 폴더
__MACOSX/

# ==========================================
# 4. 오피스 / 한글 / 텍스트 편집기 임시 파일
# ==========================================
# MS Office(워드, 엑셀, PPT) 열었을 때 생성되는 잠금/임시 파일
~$*
# 한글(HWP) 및 일반 백업 파일
*.bak
*.backup
*.hwp.bak
*.hwpx.bak
# 기타 일반 임시/다운로드 중 파일
*.tmp
*.crdownload
*.download
*.part
*~

# ==========================================
# 5. 에디터 및 IDE 설정
# ==========================================
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# 6. 웹 개발 / 빌드 산출물 (향후 확장 대비)
# ==========================================
node_modules/
dist/
build/
.cache/
*.log

# ==========================================
# 7. 환경 변수 및 보안 키
# ==========================================
.env
.env*.local
